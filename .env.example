# Configure these as server-side environment variables in the deployment platform.
# Keep the client secret out of NEXT_PUBLIC_* variables.
BAYQI_GATEWAY_ENVIRONMENT=sandbox
BAYQI_GATEWAY_BASE_URL=https://gateway.example.onrender.com
BAYQI_GATEWAY_CLIENT_ID=
BAYQI_GATEWAY_CLIENT_SECRET=

# Prisma database URLs required by the existing Nishop product catalogue.
POSTGRES_PRISMA_URL_2=
DIRECT_URL=
