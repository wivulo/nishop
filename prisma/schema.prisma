// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_PRISMA_URL_2")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  photoURL  String?
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  imageSrc    String
  price       Float
  Emphasis    Boolean
  colors      Json?
  category    String
}

model CheckoutAttempt {
  attemptId         String   @id
  paymentId         String?  @unique
  merchantReference String   @unique
  amount            Float
  currency          String   @default("AOA")
  status            String   @default("CREATING")
  errorCode         String?
  items             Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt])
}

model ProductView {
  id          Int      @id @default(autoincrement())
  productId   Int?
  productName String
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}
